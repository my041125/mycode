<?xml version="1.0" encoding="UTF-8"?>
<!--
  mycode：一个从零手写的命令行 AI 编程助手（个人玩具项目）

  设计原则：除 JSON 序列化外不引入任何框架依赖。
  目的是让人看清 agent 到底由哪些零件组成，而不是再学一套框架 API。

  构建产物：target/mycode.jar（可独立运行，java -jar 直接启动）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 项目坐标 -->
  <groupId>mycode</groupId>
  <artifactId>mycode</artifactId>
  <version>1.0</version>
  <name>mycode</name>

  <properties>
    <!-- JDK 17：因为用到了 record、文本块、switch 表达式、java.net.http -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <!-- 源码含中文注释，必须显式声明 UTF-8，否则 Windows 下会按 GBK 读导致乱码 -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      唯一依赖：只用来序列化和解析 HTTP 报文（JSON）。
      注意内核层刻意不暴露 Jackson 的类型 —— Tool.parameters() 返回的是普通 Map，
      将来换成 Fastjson 或 Gson，业务代码一行都不用改。
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.2</version>
    </dependency>
  </dependencies>

  <build>
    <!-- 产物固定叫 mycode.jar，启动脚本直接引用这个名字 -->
    <finalName>mycode</finalName>
    <plugins>
      <!--
        exec 插件：开发时免打包直接跑，支持 mvn exec:java 传命令行参数。
        想换入口类时可以临时覆盖：-Dexec.mainClass=mycode.其他类
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>mycode.Main</mainClass>
        </configuration>
      </plugin>

      <!--
        shade 插件：把 jackson 一起打进 mycode.jar，得到一个可直接 java -jar 运行的单文件。
        没有它就得手动拼 classpath，命令行工具的启动体验会差很多。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!-- 写入 Main-Class，让 jar 可以直接执行 -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>mycode.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
