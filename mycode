#!/usr/bin/env bash
# ============================================================
#  mycode 启动脚本（Git Bash / WSL / macOS / Linux）
#
#  用法：
#    ./mycode                 进入交互模式
#    ./mycode "问题"           单次执行
#    ./mycode --demo          离线演示，不联网不花钱
#    ./mycode --help          查看全部命令
#
#  首次运行会自动打包，之后直接启动 jar，速度更快。
# ============================================================
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="$APP_DIR/target/mycode.jar"

if [ ! -f "$JAR" ]; then
    echo "[mycode] 首次运行，正在构建 jar…"
    (cd "$APP_DIR" && mvn -q package -DskipTests)
fi

# mycode.home 让程序在别的目录运行时也能找到 agent.properties
exec java -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 \
     -Dmycode.home="$APP_DIR" -jar "$JAR" "$@"
