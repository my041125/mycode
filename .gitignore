target/
.idea/
*.iml
.vscode/
*.log

# 项目自带的 Python 虚拟环境（技能脚本依赖装在这里）
.venv/

# 便携软件（LibreOffice 等）与安装包缓存，体积太大不进仓库
tools/
downloads/

# 技能用到的 npm 依赖（docx 等），本地安装，不进仓库
# package.json / package-lock.json 要提交，方便换机器一条命令还原
node_modules/

# 含 API Key，绝对不要提交到 git
agent.properties

# 修改快照仓库：属于本地状态，随项目走没有意义
.mycode/backups/

# 历史遗留的单文件备份（旧版本工具生成）
*.bak
